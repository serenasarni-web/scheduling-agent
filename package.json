    "pg": "^8.11.2",
    "node-postgres": "^0.0.1",
    "axios": "^1.6.2",
    "googleapis": "^118.0.0",
    "google-auth-library": "^9.4.1",
    "jwt-decode": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "express-session": "^1.17.3",
    "uuid": "^9.0.1",
